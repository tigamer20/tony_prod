# Copy to server/.env and adjust.
# Local Postgres from docker-compose (npm run db:up). On Neon, paste its connection string here.
DATABASE_URL="postgresql://tonyprod:tonyprod@localhost:5433/tonyprod?schema=public"

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"

# Port for the API + realtime server.
PORT=4000

# Chat attachments are stored in the database (10 MB per file).
# Cap on the total size of all attachments, in MB. Neon's free plan holds 0.5 GB for everything.
UPLOAD_STORAGE_LIMIT_MB=300

# Origin of the web client in development (Vite dev server).
CLIENT_ORIGIN="http://localhost:5173"
